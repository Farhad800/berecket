// Bereket Plastic — Factory Management System
// Full schema for all departments. Designed up front so later stages don't restructure.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ───────────────────────────── Identity & access ─────────────────────────────

model Department {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  users     User[]
  createdAt DateTime @default(now())
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false) // system roles can't be deleted
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId     String
  permission String // "resource:action", e.g. "orders:create"
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
}

model User {
  id                 String      @id @default(cuid())
  employeeId         String      @unique
  fullName           String
  username           String      @unique
  email              String?     @unique
  passwordHash       String
  mustChangePassword Boolean     @default(true)
  active             Boolean     @default(true)
  locale             String      @default("en")
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id])
  roleId             String
  role               Role        @relation(fields: [roleId], references: [id])
  failedLogins       Int         @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  sessions          Session[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  auditLogs         AuditLog[]

  @@index([roleId])
}

model Session {
  id        String   @id // SHA-256 hash of the cookie token — raw token never stored
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // e.g. "order.create", "qc.hold", "stock.adjust"
  entityType String
  entityId   String?
  reason     String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Sequential, human-readable document numbers (ORD-2026-0001, etc.)
model Counter {
  name  String @id
  value Int    @default(0)
}

// ───────────────────────────── Master data ─────────────────────────────

model Product {
  id               String             @id @default(cuid())
  code             String             @unique
  kind             ItemKind           @default(PRODUCT)
  name             String
  name2            String? // second name (e.g. Turkish) shown under the main one
  specifications   String?
  unit             String             @default("pcs")
  material         String?
  color            String?
  weightGrams      Decimal?           @db.Decimal(10, 2)
  cycleTimeSec     Decimal?           @db.Decimal(8, 2)
  qcRequired       Boolean            @default(false) // shown to QC as "inspect every day's production"
  // One mold makes many products: each printed label on the same molded item is its own product.
  moldId           String?
  mold             Mold?              @relation(fields: [moldId], references: [id], onDelete: SetNull)
  /// The printed label this product carries (1 per piece); null = product has no label.
  labelId          String?
  label            Product?           @relation("ProductLabel", fields: [labelId], references: [id], onDelete: SetNull)
  labelledProducts Product[]          @relation("ProductLabel")
  piecesPerCarton  Int?
  /// For packaging/materials stocked in kg but used by the piece (e.g. one nylon bag = 0.012 kg).
  unitWeightKg     Decimal?           @db.Decimal(12, 6)
  /// Cost of one unit (1 pc or 1 kg) as the accountant typed it: price + currency + rate to IQD (1 for IQD).
  /// costIqd = costPrice × costRate is what product costs are calculated with.
  costPrice        Decimal?           @db.Decimal(18, 6)
  costCurrency     Currency?
  costRate         Decimal?           @db.Decimal(18, 6)
  costIqd          Decimal?           @db.Decimal(18, 6)
  costUpdatedAt    DateTime?
  components       ProductComponent[] @relation("Recipe")
  usedIn           ProductComponent[] @relation("UsedIn")
  archivedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  orderLines       OrderLine[]
  entries          ProductionEntry[]
  stockMovements   StockMovement[]

  @@index([name])
  @@index([moldId])
  @@index([kind])
  @@index([labelId])
}

enum MachineStatus {
  AVAILABLE
  RUNNING
  DOWN
  MAINTENANCE
  RETIRED
}

model Machine {
  id             String               @id @default(cuid())
  code           String               @unique // e.g. "M-01"
  name           String
  manufacturer   String?              @default("Toyo")
  model          String?
  tonnage        Int?
  status         MachineStatus        @default(AVAILABLE)
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  molds          Mold[]               @relation("MoldCurrentMachine")
  maintenance    MaintenanceRequest[]
  serviceReports ServiceReport[]
  preventive     PreventiveTask[]
}

enum MoldStatus {
  AVAILABLE
  IN_USE
  IN_REPAIR
  RETIRED
}

model Mold {
  id               String               @id @default(cuid())
  code             String               @unique
  name             String
  cavities         Int                  @default(1)
  products         Product[]
  currentMachineId String?
  currentMachine   Machine?             @relation("MoldCurrentMachine", fields: [currentMachineId], references: [id])
  status           MoldStatus           @default(AVAILABLE)
  shotCount        Int                  @default(0)
  notes            String?
  archivedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  maintenance      MaintenanceRequest[]
  serviceReports   ServiceReport[]      @relation("ServiceMold")
  removedIn        ServiceReport[]      @relation("MoldRemoved")
  installedIn      ServiceReport[]      @relation("MoldInstalled")
  preventive       PreventiveTask[]
}

model DefectCategory {
  id     String         @id @default(cuid())
  code   String         @unique
  name   String
  active Boolean        @default(true)
  issues QualityIssue[]
}

// ───────────────────────────── Orders (a sheet of products and amounts) ─────────────────────────────

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum OrderStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model Order {
  id          String      @id @default(cuid())
  number      String      @unique
  status      OrderStatus @default(OPEN)
  createdById String
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lines       OrderLine[]
  stockDocs   StockDoc[]

  @@index([status])
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineNo    Int
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  @@unique([orderId, lineNo])
  @@index([productId])
}

// ───────────────────────────── Daily production ─────────────────────────────

enum Shift {
  A // 07:00–15:00
  B // 15:00–23:00
  C // 23:00–07:00
}

enum EntryQcStatus {
  NOT_INSPECTED
  APPROVED
  REJECTED // some or all pieces rejected
}

/// What was produced: one product, one shift, one day. Adds to stock automatically.
model ProductionEntry {
  id          String          @id @default(cuid())
  day         DateTime        @db.Date // factory calendar day
  shift       Shift
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  quantity    Int
  qcStatus    EntryQcStatus   @default(NOT_INSPECTED)
  notes       String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  inspections QcInspection[]
  issues      QualityIssue[]
  movements   StockMovement[]

  @@index([day])
  @@index([productId, day])
  @@index([qcStatus])
}

// ───────────────────────────── Technical service ─────────────────────────────

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  VERIFIED
  CANCELLED
}

model MaintenanceRequest {
  id             String            @id @default(cuid())
  number         String            @unique
  machineId      String
  machine        Machine           @relation(fields: [machineId], references: [id])
  moldId         String?
  mold           Mold?             @relation(fields: [moldId], references: [id])
  title          String
  description    String?
  priority       Priority          @default(NORMAL)
  status         MaintenanceStatus @default(OPEN)
  machineDown    Boolean           @default(false)
  isPreventive   Boolean           @default(false)
  reportedById   String
  assignedToId   String?
  resolution     String?
  readyAt        DateTime?
  completedAt    DateTime?
  verifiedAt     DateTime?
  verifiedById   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  serviceReports ServiceReport[]

  @@index([status])
  @@index([machineId])
}

model ServiceReport {
  id                   String              @id @default(cuid())
  number               String              @unique
  date                 DateTime
  shift                Shift
  technicianId         String
  machineId            String
  machine              Machine             @relation(fields: [machineId], references: [id])
  moldId               String?
  mold                 Mold?               @relation("ServiceMold", fields: [moldId], references: [id])
  maintenanceRequestId String?
  maintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id])
  moldRemovedId        String?
  moldRemoved          Mold?               @relation("MoldRemoved", fields: [moldRemovedId], references: [id])
  moldInstalledId      String?
  moldInstalled        Mold?               @relation("MoldInstalled", fields: [moldInstalledId], references: [id])
  moldChangeReason     String?
  workPerformed        String
  breakdown            String?
  startTime            DateTime
  endTime              DateTime?
  downtimeMinutes      Int                 @default(0)
  spareParts           String?
  repairsCompleted     String?
  outstandingWork      String?
  followUp             String?
  notes                String?
  createdAt            DateTime            @default(now())

  @@index([machineId, date])
  @@index([moldId])
}

model PreventiveTask {
  id           String    @id @default(cuid())
  machineId    String?
  machine      Machine?  @relation(fields: [machineId], references: [id])
  moldId       String?
  mold         Mold?     @relation(fields: [moldId], references: [id])
  title        String
  intervalDays Int
  lastDoneAt   DateTime?
  nextDueAt    DateTime
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
}

// ───────────────────────────── Quality control ─────────────────────────────

enum QcDecision {
  APPROVE
  REJECT
}

model QcInspection {
  id           String          @id @default(cuid())
  number       String          @unique
  entryId      String
  entry        ProductionEntry @relation(fields: [entryId], references: [id])
  inspectorId  String
  inspectedAt  DateTime        @default(now())
  sampleOnly   Boolean         @default(true)
  qtyInspected Int
  qtyRejected  Int             @default(0)
  decision     QcDecision
  notes        String?
  createdAt    DateTime        @default(now())
  issues       QualityIssue[]

  @@index([entryId])
}

enum Severity {
  MINOR
  MAJOR
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  AWAITING_VERIFICATION
  RESOLVED
  REOPENED
}

model QualityIssue {
  id                   String             @id @default(cuid())
  number               String             @unique
  entryId              String
  entry                ProductionEntry    @relation(fields: [entryId], references: [id])
  inspectionId         String?
  inspection           QcInspection?      @relation(fields: [inspectionId], references: [id])
  categoryId           String
  category             DefectCategory     @relation(fields: [categoryId], references: [id])
  severity             Severity
  description          String
  recommendedAction    String?
  responsibleDept      String // PRODUCTION, SERVICE, QC, WAREHOUSE
  assignedToId         String?
  status               IssueStatus        @default(OPEN)
  maintenanceRequestId String?
  createdById          String
  resolvedAt           DateTime?
  verifiedById         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  actions              CorrectiveAction[]

  @@index([status, severity])
}

model CorrectiveAction {
  id            String       @id @default(cuid())
  issueId       String
  issue         QualityIssue @relation(fields: [issueId], references: [id])
  description   String
  performedById String
  performedAt   DateTime     @default(now())
}

// ───────────────────────────── Warehouse stock ─────────────────────────────

enum StockMoveType {
  PRODUCTION // automatic, from a daily production entry (incl. corrections)
  QC_REJECT // automatic, pieces rejected by QC
  OUT // goods leaving the warehouse
  ADJUST // count correction, damage, scrap
  RECEIVE // (older) stickers / materials received
  USE // labels / materials / packaging used by production (automatic), or (older) taken to production
  INPUT // stock document: in without money (return, transfer, count correction…)
  OUTPUT // stock document: out without money
  BUY // stock document: bought, with price
  SELL // stock document: sold, with price
}

enum StockDocType {
  INPUT
  OUTPUT
  BUY
  SELL
}

enum Currency {
  IQD
  USD
  EUR
}

/// One stock movement document (Input / Output / Buy / Sell) with its lines (StockMovement.docId).
model StockDoc {
  id            String          @id @default(cuid())
  number        String          @unique // IN-2026-0001, OUT-…, BUY-…, SAL-…
  type          StockDocType
  reason        String? // Input/Output: RETURN, TRANSFER, COUNT, DAMAGE, SAMPLE, OTHER
  party         String? // the customer's name as it was (Buy: bought from · Sell: sold to)
  phone         String? // customer / supplier phone, printed on the receipt
  invoiceNo     String? // Sell: automatic INV-2026-0001 · Buy: the supplier's invoice number (typed)
  currency      Currency?
  orderId       String?
  order         Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId    String? // Buy / Sell: the customer account it is booked to (bought from or sold to)
  customer      Customer?       @relation(fields: [customerId], references: [id])
  supplierRef   String? // Buy: the supplier's own invoice number (typed); invoiceNo is our automatic PUR-2026-0001
  rate          Decimal?        @db.Decimal(18, 6) // Buy in USD/EUR: 1 USD/EUR = rate IQD on that day (the purchase's IQD value)
  delivery      String? // Sell: where the goods are delivered
  note          String?
  subtotal      Decimal?        @db.Decimal(16, 2) // Sell: sum of the lines after line discounts
  discountKind  DiscountKind? // Sell: discount on the whole invoice
  discountValue Decimal?        @db.Decimal(16, 4) // the % or the amount typed
  discount      Decimal?        @db.Decimal(16, 2) // the invoice discount in money
  total         Decimal?        @db.Decimal(16, 2) // Buy / Sell: what is charged (sum of lines − invoice discount)
  createdById   String
  createdAt     DateTime        @default(now())
  lines         StockMovement[]
  payments      CashEntry[]

  @@index([type, createdAt])
  @@index([orderId])
  @@index([customerId])
}

enum DiscountKind {
  PERCENT
  AMOUNT
}

/// A customer account (26–27 Oct 2026): the factory sells to it and buys from it (suppliers are customers too).
/// Balance per currency = money received − money paid to them − sales + purchases (negative = they owe the factory).
model Customer {
  id         String      @id @default(cuid())
  code       String      @unique // C-0001 (automatic, can be changed)
  name       String
  phone      String?
  address    String?
  note       String?
  archivedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  sales      StockDoc[]
  payments   CashEntry[]

  @@index([name])
}

/// What a stock item is. Only PRODUCT is made on machines, ordered and inspected by QC.
enum ItemKind {
  PRODUCT
  STICKER // printed labels kept in stock
  MATERIAL // raw materials: granules, dyes, regrind…
  PACKAGING // nylon bags, cartons, stretch film, tape, pallets…
}

enum ComponentBasis {
  PIECE // per piece produced (labels, handles, grams of material)
  CARTON // per carton (cartons, nylon bags, tape…)
}

/// What one product uses: its recipe ("made of") and packaging. Taken off stock when production is entered.
model ProductComponent {
  id          String         @id @default(cuid())
  productId   String
  product     Product        @relation("Recipe", fields: [productId], references: [id], onDelete: Cascade)
  componentId String
  component   Product        @relation("UsedIn", fields: [componentId], references: [id])
  /// kg item + PIECE: grams per piece · kg item + CARTON: bags per carton (× the item's weight per bag)
  /// pcs item: pieces per piece or per carton
  qty         Decimal        @db.Decimal(14, 4)
  per         ComponentBasis
  createdAt   DateTime       @default(now())

  @@unique([productId, componentId, per])
  @@index([componentId])
}

/// Stock ledger: the balance of a product is the sum of its movements. Never edited.
model StockMovement {
  id            String           @id @default(cuid())
  productId     String
  product       Product          @relation(fields: [productId], references: [id])
  type          StockMoveType
  qty           Decimal          @db.Decimal(14, 3) // + in, − out (pieces, or kg for materials)
  entryId       String?
  entry         ProductionEntry? @relation(fields: [entryId], references: [id])
  docId         String?
  doc           StockDoc?        @relation(fields: [docId], references: [id])
  unitPrice     Decimal?         @db.Decimal(18, 6) // Buy / Sell only, in the document's currency (up to 6 decimals, e.g. 0.005 per label)
  discountKind  DiscountKind? // Sell: discount on this line
  discountValue Decimal?         @db.Decimal(16, 4) // the % or the amount typed
  discount      Decimal?         @db.Decimal(16, 2) // the line discount in money
  reference     String? // e.g. who/where the goods went
  reason        String?
  createdById   String
  createdAt     DateTime         @default(now())

  @@index([productId])
  @@index([createdAt])
  @@index([docId])
}

// ───────────────────────────── Collaboration ─────────────────────────────

model Comment {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model Attachment {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  storageKey   String // private blob pathname — served through an authorised route only
  filename     String
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  /// Values for the translated text (messages nt.<type>), so each person reads it in their own language.
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/// A phone or computer that receives push notifications for a user (Web Push).
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  failures   Int      @default(0)

  @@index([userId])
}

enum CashKind {
  DEPOSIT // money in by hand
  EXPENSE // money out by hand (with a category)
  SALE // money received for a Sell document
  PURCHASE // money paid for a Buy document
  EXCHANGE // one currency changed into another (two entries, same number)
  TRANSFER // the same currency moved from one safe to another (two entries, same number)
}

/// A safe (cash box). Each holds the currencies chosen for it; every CashEntry belongs to one safe.
model Safe {
  id         String      @id @default(cuid())
  name       String      @unique
  currencies Currency[]
  isMain     Boolean     @default(false) // the first safe; default choice, can't be deleted
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  entries    CashEntry[]
}

/// Expense categories for money going out of the safe. Built-in ones have a key (translated); added ones only a name.
model ExpenseCategory {
  id         String      @id @default(cuid())
  key        String?     @unique
  name       String      @unique
  archivedAt DateTime?
  createdAt  DateTime    @default(now())
  entries    CashEntry[]
}

/// The safe: every movement of money. Balance per currency = SUM(amount). Positive = in, negative = out.
model CashEntry {
  id          String           @id @default(cuid())
  number      String // CIN-2026-0001, COUT-…, RCV-…, PAY-…, EXC-… (an exchange has two entries with one number)
  kind        CashKind
  currency    Currency
  amount      Decimal          @db.Decimal(16, 2)
  rate        Decimal?         @db.Decimal(18, 6) // exchange: 1 unit of the stronger currency (EUR > USD > IQD) = rate units of the other
  safeId      String
  safe        Safe             @relation(fields: [safeId], references: [id])
  categoryId  String?
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id])
  stockDocId  String?
  stockDoc    StockDoc?        @relation(fields: [stockDocId], references: [id], onDelete: SetNull)
  customerId  String? // money received from, or paid to, a customer account
  customer    Customer?        @relation(fields: [customerId], references: [id])
  party       String?
  note        String?
  createdById String
  createdAt   DateTime         @default(now())

  @@index([currency])
  @@index([safeId, currency])
  @@index([number])
  @@index([stockDocId])
  @@index([customerId])
  @@index([createdAt])
}

enum ReceiptFor {
  SELL
  BUY
  PAYMENT // money received later for a sale (RCV)
}

/// A saved receipt layout (accountant, 25 Oct 2026): banner, paper, fields, columns, language.
model ReceiptLayout {
  id          String     @id @default(cuid())
  name        String
  docType     ReceiptFor
  language    String // ar | en | tr | ar-en
  isDefault   Boolean    @default(false)
  banner      String?    @db.Text // image as a data: URL (kept in the database so it works on every server)
  settings    Json
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([docType])
}

/// One-time submission numbers (code review M2, 26 Oct 2026): a form sends a fresh number with each save;
/// it is stored in the same transaction as the save, so a double-click or network retry is applied once.
/// A failed save stores nothing, so it can be retried. Rows older than 30 days are removed automatically.
model SubmissionKey {
  key       String   @id
  userId    String
  action    String
  result    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
